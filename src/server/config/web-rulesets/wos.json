[
  {
    "match": "^www\\.webofscience\\.com/wos/woscc/smart-search$",
    "keep": [
      {
        "selector": "div.simple-search-container",
        "drop": []
      }
    ]
  },
  {
    "match": "^www\\.webofscience\\.com/wos/woscc/basic-search$",
    "keep": [
      {
        "selector": "div.select-database-on-simple-search-container",
        "drop": []
      },
      {
        "selector": "form#snSearchType",
        "drop": [
          "mat-icon"
        ]
      }
    ]
  },
  {
    "match": "^www\\.webofscience\\.com/wos/woscc/summary/",
    "keep": [
      {
        "selector": "app-search-friendly-display",
        "drop": [
          "button.copy-link-button",
          "button.search-create-alert-btn",
          "div.addKeywordContainer",
          "mat-icon",
          "a[href*=\"/api/gateway\"]"
        ]
      },
      {
        "selector": "fieldset#filter-section-PY",
        "drop": [
          "mat-icon",
          "a[href*=\"/api/gateway\"]"
        ]
      },
      {
        "selector": "fieldset#filter-section-DT",
        "drop": [
          "mat-icon",
          "a[href*=\"/api/gateway\"]"
        ]
      },
      {
        "selector": "div.results",
        "drop": [
          "li:has(app-record:empty)",
          "app-jcr-sidenav",
          "button[aria-label^='Options for record']",
          "button.ecr-button-summary",
          "app-refine-export",
          "mat-icon",
          "a[href*=\"/api/gateway\"]"
        ],
        "plaintify": [
          "app-record a[href*='/wos/author/']",
          "app-record a[href*='general-summary']",
          "app-record a[href*='citing-summary']",
          "app-record a[href*='cited-references-summary']"
        ]
      }
    ]
  },
  {
    "match": "^www\\.webofscience\\.com/wos/woscc/full-record/",
    "keep": [
      {
        "selector": "div.top-sticky-pageControl",
        "drop": [
          "mat-icon",
          "a[href*=\"/api/gateway\"]"
        ]
      },
      {
        "selector": "#snMainArticle",
        "drop": [
          "button[aria-label^='More information about']",
          "button[aria-label='affiliation details']",
          "#HiddenSecTa-showMoreDataButton",
          "mat-icon",
          "a[href*=\"/api/gateway\"]"
        ],
        "plaintify": [
          "app-full-record-authors",
          "app-full-record-author-identifiers",
          "app-full-record-conferences",
          "app-full-record-keywords",
          "app-full-record-author-organization",
          "app-full-record-addresses-data",
          "app-full-record-categories-classification",
          "app-full-record-funding"
        ]
      },
      {
        "selector": "#snCitationData",
        "drop": [
          "mat-icon",
          "a[href*=\"/api/gateway\"]"
        ],
        "plaintify": [
          "section"
        ]
      }
    ]
  }
]